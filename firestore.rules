rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player's save: only they can read or write it
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.method == 'get' || request.resource.data.save.size() < 900000);
    }
    // Public profile (name, hero count) so friends can find you
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Usernames are unique: one document per lowercase name
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
