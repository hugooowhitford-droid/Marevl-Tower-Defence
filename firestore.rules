rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.save.size() < 900000;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /live/{id} {
      function signed() { return request.auth != null; }
      function isA() { return request.auth.uid == resource.data.a; }
      function isB() { return request.auth.uid == resource.data.b; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function nd() { return request.resource.data; }
      allow read: if signed() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      allow create: if signed()
        && nd().a == request.auth.uid && nd().b != request.auth.uid
        && nd().status == 'request'
        && nd().ar == false && nd().br == false && nd().ac == false && nd().bc == false
        && nd().aDone == false && nd().bDone == false
        && nd().ao.h.size() == 0 && nd().bo.h.size() == 0;
      allow update: if signed() && (isA() || isB())
        && nd().a == resource.data.a && nd().b == resource.data.b
        && (
          // after the trade is done, each side may only mark itself as settled
          (resource.data.status == 'done'
            && ((isA() && changed().hasOnly(['aDone']) && nd().aDone == true)
             || (isB() && changed().hasOnly(['bDone']) && nd().bDone == true)))
          // answering / cancelling a request
          || (resource.data.status == 'request' && changed().hasOnly(['status', 'u'])
            && ((isB() && nd().status in ['open', 'declined']) || (isA() && nd().status == 'cancelled')))
          // inside the open trade window
          || (resource.data.status == 'open'
            && (nd().status in ['open', 'cancelled', 'done'])
            && (isA() ? !changed().hasAny(['bo', 'aDone', 'bDone']) : !changed().hasAny(['ao', 'aDone', 'bDone']))
            // changing an offer clears every accept and confirm
            && (!changed().hasAny(['ao', 'bo'])
              || (nd().ar == false && nd().br == false && nd().ac == false && nd().bc == false))
            // you can only accept / confirm for yourself; the other side's flags can only be cleared
            && (isA() ? ((nd().br == resource.data.br || nd().br == false) && (nd().bc == resource.data.bc || nd().bc == false))
                      : ((nd().ar == resource.data.ar || nd().ar == false) && (nd().ac == resource.data.ac || nd().ac == false)))
            // confirming needs both accepts, and finishing needs both confirms with no offer change
            && (!(nd().ac || nd().bc) || (nd().ar && nd().br))
            && (nd().status != 'done' || (nd().ac && nd().bc && !changed().hasAny(['ao', 'bo']))))
        );
    }
    match /trades/{id} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.claimed == false;
      allow update: if request.auth != null && (
        (resource.data.to == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.from == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimed']))
        || (resource.data.from == request.auth.uid && resource.data.status in ['accepted', 'declined']
          && resource.data.claimed == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])));
    }
  }
}
